#!/usr/bin/env python3
"""agent-sessions: Ueberblick ueber alle frueheren Agenten-Sitzungen.

Urspruenglich von bernhard2804 als Experiment "claude-sitzungen" vorgeschlagen
(mstio/polaris-connector#3); hier als Fenster "Alle Sitzungen ..." des
Agenten-Starters (Menue bleibt schlank, volle Funktion im eigenen Fenster).

Zeigt alle lokalen Sitzungen von Claude Code, Codex und Agy (dazu opencode
und experimentell Copilot, Pi, Gemini CLI, Grok, sofern vorhanden) wie die
Seitenleiste von Claude Chat: neueste oben, Agentenwahl oben im Rahmen
(Tab/Shift+Tab), Vorschau und Inhaltssuche fuer Claude, Codex, Agy und
opencode, fuer Claude
zusaetzlich Abzweig (claude --resume --fork-session). Enter setzt eine
Sitzung in einem neuen Terminalfenster fort. Terminal-Oberflaeche mit fzf.

Aufruf:
  agent-sessions                             Uebersicht
  agent-sessions --liste [--agent A]         Zeilen fuer fzf (SCHLUESSEL<TAB>Anzeige)
  agent-sessions --liste --inhalt TEXT       Inhaltssuche (Agent aus FZF_BORDER_LABEL)
  agent-sessions --wechsel 1|-1|0            fzf-transform: Agentenwahl
  agent-sessions --vorschau ID               Vorschau einer Sitzung
  agent-sessions --oeffnen ID [--abzweig]    Sitzung in neuem Fenster oeffnen

Liest nur: $CLAUDE_CONFIG_DIR (Standard ~/.claude) projects/*/*.jsonl und
sessions/*.json; Codex/Agy-Liste ueber bin/agent-launcher-status, fuer
Vorschau und Suche die Codex-Rollouts (~/.codex/sessions) und die
Agy-Verlaeufe (~/.gemini/antigravity-cli/brain/<id>/.system_generated/logs/
transcript_full.jsonl bzw. transcript.jsonl), opencode (~/.local/share/opencode/
opencode.db, nur lesend) und die Ablagen von Copilot, Pi, Gemini CLI und Grok
(siehe WEITERE und SCANNER). Zwischenspeicher
$XDG_CACHE_HOME/agent-sessions/index.json (wegwerfbar, nur fuer den Nutzer
lesbar: enthaelt Gespraechsauszuege). Kein Hintergrunddienst, kein Timer, kein Netz.
Abhaengigkeiten: python3, fzf; optional rg (schnellere Inhaltssuche),
hyprctl (Fokus auf schon offene Sitzung), uwsm-app + xdg-terminal-exec (Omarchy).
"""
import glob
import json
import os
import re
import shutil
import sqlite3
import subprocess
import sys
import time
import urllib.parse
from datetime import date, datetime, timedelta

HOME = os.path.expanduser("~")
BASIS = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(HOME, ".claude")
PROJ = os.path.join(BASIS, "projects")
REG = os.path.join(BASIS, "sessions")
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"),
                     "agent-sessions", "index.json")
UUID = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")
CODEX = os.path.join(HOME, ".codex", "sessions")
AGY_BRAIN = os.path.join(HOME, ".gemini", "antigravity-cli", "brain")
SELF = os.path.abspath(__file__)
VERSION = 3  # 3: Tokens, Kontext, Agentenzeit
WOCHENTAG = {"de": ["Mo", "Di", "Mi", "Do", "Fr", "Sa", "So"],
             "en": ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]}


def sprache():
    """de oder en: --lang bzw. AGENT_LAUNCHERS_LANG (Einstellung des Widgets),
    sonst die Systemsprache; Englisch als Rueckfall. Kinder (fzf-Aufrufe)
    erben die Umgebung und damit dieselbe Sprache."""
    v = os.environ.get("AGENT_LAUNCHERS_LANG", "")
    if v in ("de", "en"):
        return v
    for k in ("LC_ALL", "LC_MESSAGES", "LANG"):
        x = os.environ.get(k)
        if x:
            return "de" if x.lower().startswith("de") else "en"
    return "en"


def tr(de, en):
    return de if sprache() == "de" else en
# Von einer laufenden Claude-Sitzung gesetzt (nicht vom Nutzer): sonst gilt die
# neue Sitzung als Kind und speichert u. a. ihren Verlauf nicht. Eigene
# Einstellungen wie CLAUDE_CODE_USE_BEDROCK bleiben erhalten.
LAUFZEIT_VARS = {"CLAUDECODE", "CLAUDE_PID", "CLAUDE_EFFORT", "CLAUDE_CODE_CHILD_SESSION", "CLAUDE_CODE_SESSION_ID",
                 "CLAUDE_CODE_ENTRYPOINT", "CLAUDE_CODE_EXECPATH", "CLAUDE_CODE_SSE_PORT",
                 "CLAUDE_CODE_SESSION_ATTENDED", "CLAUDE_CODE_BRIDGE_SESSION_ID",
                 "CLAUDE_CODE_MESSAGING_SOCKET", "CLAUDE_CODE_MESSAGING_TOKEN"}

# Steuerzeichen (auch ESC, C1 und Bidi-Steuerung) entfernen: Titel und Texte
# sind Fremdinhalt (Modellausgaben, eingefuegte Texte) und duerfen das
# Terminal nicht steuern.
CTRL = re.compile("[\x00-\x08\x0b-\x1f\x7f-\x9f\u061c\u200b\u200e\u200f\u2060\ufeff\u202a-\u202e\u2066-\u2069]")
REMINDER = re.compile(r"<system-reminder>.*?</system-reminder>", re.S)
TYPEN = ('"type":"user"', '"type":"assistant"', '"type":"ai-title"',
         '"type":"custom-title"', '"type":"last-prompt"', '"subtype":"turn_duration"')
# Symbol fuer per Remote Control erreichbare Claude-Sitzungen: Nerd-Font-Glyphe
# md-cellphone_link (U+F0121), wie Omarchy Material-Design-Glyphen nutzt.
FERN = "\U000f0121"
# Codex: neue Rollouts (item_completed) und aeltere (event_msg). Agy: Eingabe
# steht in <USER_REQUEST>, daneben Metadaten und Einstellungen.
TEILE_CLAUDE = ('"type":"user"', '"type":"assistant"')
TEILE_CODEX = ('"UserMessage"', '"AgentMessage"', '"user_message"', '"agent_message"')
TEILE_AGY = ('"USER_INPUT"', '"PLANNER_RESPONSE"')
CODEX_INTERN = ("<environment_context", "<user_instructions", "# AGENTS.md instructions", "<turn_aborted")
AGY_FRAGE = re.compile(r"<USER_REQUEST>\s*(.*?)\s*</USER_REQUEST>", re.S)


# Weitere Agenten, nur im Fenster (das Menue bleibt bei Claude, Codex, Agy).
# Ablageorte und Formate teils nach Sudhanshugtm/omarchy-session-browser (MIT).
# opencode ist an echten Sitzungen geprueft (Liste, Vorschau, Suche); die
# uebrigen nur an Beispielen: experimentell, Liste und Fortsetzen.
OPENCODE_DB = os.path.join(HOME, ".local", "share", "opencode", "opencode.db")
COPILOT = os.path.join(HOME, ".copilot")
PI = os.path.join(HOME, ".pi", "agent", "sessions")
GEMINI_TMP = os.path.join(HOME, ".gemini", "tmp")
GROK = os.path.expanduser(os.environ.get("GROK_HOME") or os.path.join(HOME, ".grok"))
WEITERE = {  # Agent: (Anzeigename, Befehl zum Fortsetzen ohne ID, an echten Sitzungen geprueft)
    "opencode": ("opencode", ["opencode", "--session"], True),
    "copilot": ("Copilot", ["copilot", "--resume"], False),
    "pi": ("Pi", ["pi", "--session"], False),
    "gemini": ("Gemini", ["gemini", "--resume"], False),
    "grok": ("Grok", ["grok", "--resume"], False),
}
ID_WEITERE = re.compile(r"[A-Za-z0-9][A-Za-z0-9_-]{7,79}")  # nur fullmatch: kein "-" vorn, kein "/" oder "."


def _vorhanden(agent):
    """Reiter nur fuer Agenten, die hier Sitzungsdateien haben (billig: stat/glob,
    leere Ordner zaehlen nicht)."""
    if agent == "opencode":
        return os.path.isfile(OPENCODE_DB)
    muster = {"copilot": [os.path.join(COPILOT, "session-state", "*", "events.jsonl"),
                          os.path.join(COPILOT, "history-session-state", "*.json")],
              "pi": [os.path.join(PI, "*", "*.jsonl"), os.path.join(PI, "*.jsonl")],
              "gemini": [os.path.join(GEMINI_TMP, "*", "chats", "session-*.json*")],
              "grok": [os.path.join(GROK, "sessions", "*", "*", "summary.json")]}[agent]
    return any(next(glob.iglob(m), None) for m in muster)


AGENTEN = ["alle", "claude", "codex", "agy"] + [a for a in WEITERE if _vorhanden(a)]
def name(agent):
    if agent in WEITERE:
        return WEITERE[agent][0]
    return {"alle": tr("Alle", "All"), "claude": "Claude", "codex": "Codex", "agy": "Agy"}[agent]


def _lade_status():
    """Codex/Agy liest bin/agent-launcher-status (dieselbe Logik wie das Menue)."""
    sys.dont_write_bytecode = True  # kein __pycache__ im Plugin-Ordner
    try:
        from importlib.machinery import SourceFileLoader
        from importlib.util import module_from_spec, spec_from_loader
        loader = SourceFileLoader("agent_launcher_status",
                                  os.path.join(os.path.dirname(SELF), "agent-launcher-status"))
        mod = module_from_spec(spec_from_loader(loader.name, loader))
        loader.exec_module(mod)
        return mod
    except Exception:
        return None


STATUS = _lade_status()


def sauber(s, einzeilig=True):
    s = CTRL.sub("", s or "")
    if einzeilig:
        s = " ".join(s.split())
    return s.strip()


def kurz(s, n):
    return s if len(s) <= n else s[: n - 1] + "…"


def text_aus(msg):
    """Echter Text aus message.content (ohne Werkzeug-Ergebnisse und system-reminder)."""
    if not isinstance(msg, dict):
        return ""
    c = msg.get("content")
    if isinstance(c, str):
        teile = [c]
    elif isinstance(c, list):
        teile = [_str(b.get("text")) for b in c if isinstance(b, dict) and b.get("type") == "text"]
    else:
        return ""
    return REMINDER.sub("", "\n".join(teile)).strip()


def ist_eingabe(t):
    """Vom Menschen getippte Eingabe, keine Slash-Befehl-Protokolle o. Ae."""
    return bool(t) and not t.startswith(("<command-", "<local-command", "<task-notification",
                                          "Caveat:", "[Request interrupted"))


def zeitstempel(s):
    try:
        return datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp()
    except Exception:
        return None


def _str(v):
    return v if isinstance(v, str) else ""


def _int(v):
    """Nichtnegative Zahl aus undokumentierten Feldern, sonst 0."""
    return int(v) if isinstance(v, (int, float)) and not isinstance(v, bool) and v >= 0 else 0


def auswerten(pfad):
    d = {"titel": "", "eigener_titel": "", "cwd": "", "erste": "", "letzte": "",
         "fragen": 0, "beginn": None, "ende": None, "ctx": 0, "modell": "", "arbeit_s": 0}
    letzte_eigen = ""
    nutzung = {}  # Nachrichten-ID -> Tokens; Claude schreibt je Inhaltsblock eine Zeile
    arbeit_ms = 0
    with open(pfad, encoding="utf-8", errors="replace") as f:
        for zeile in f:
            if not any(t in zeile for t in TYPEN):
                continue  # billiger Vorfilter, json.loads nur fuer relevante Zeilen
            try:
                r = json.loads(zeile)
            except Exception:
                continue
            if not isinstance(r, dict):
                continue  # Format ist undokumentiert: Unerwartetes ueberspringen
            typ = r.get("type")
            if typ == "ai-title":
                d["titel"] = _str(r.get("aiTitle")) or d["titel"]
            elif typ == "custom-title":
                d["eigener_titel"] = _str(r.get("customTitle")) or d["eigener_titel"]
            elif typ == "last-prompt":
                d["letzte"] = _str(r.get("lastPrompt"))[:2000] or d["letzte"]
            elif typ == "system" and r.get("subtype") == "turn_duration" and not r.get("isSidechain"):
                arbeit_ms += _int(r.get("durationMs"))
            elif typ in ("user", "assistant"):
                m = r.get("message")
                if typ == "assistant" and isinstance(m, dict) and isinstance(m.get("usage"), dict):
                    u = m["usage"]
                    werte = (_int(u.get("input_tokens")), _int(u.get("cache_read_input_tokens")),
                             _int(u.get("cache_creation_input_tokens")), _int(u.get("output_tokens")))
                    nutzung[_str(m.get("id")) or _str(r.get("uuid")) or str(len(nutzung))] = werte
                    if not r.get("isSidechain"):
                        d["ctx"] = werte[0] + werte[1] + werte[2]  # Kontext der letzten Anfrage
                        mod = _str(m.get("model"))
                        if mod and not mod.startswith("<"):  # "<synthetic>" = keine echte Antwort
                            d["modell"] = mod[:60]
                if r.get("isSidechain"):
                    continue
                ts = zeitstempel(r.get("timestamp", ""))
                if ts:
                    d["beginn"] = d["beginn"] or ts
                    d["ende"] = ts
                if not d["cwd"] and isinstance(r.get("cwd"), str):
                    d["cwd"] = r["cwd"]
                if typ == "user" and not r.get("isMeta"):
                    t = text_aus(r.get("message"))
                    if ist_eingabe(t):
                        d["fragen"] += 1
                        d["erste"] = d["erste"] or t[:2000]
                        letzte_eigen = t[:2000]
    if letzte_eigen:
        d["letzte"] = letzte_eigen
    w = list(nutzung.values())
    d["tok"] = {"ein": sum(a + b + c for a, b, c, _ in w), "cache": sum(b for _, b, _, _ in w),
                "aus": sum(x[3] for x in w)}
    d["arbeit_s"] = arbeit_ms // 1000
    return d


def _ende_lesen(pfad, n):
    """Letzte n Bytes einer Datei als Zeilen (erste, evtl. angeschnittene, verworfen)."""
    with open(pfad, "rb") as f:
        f.seek(0, 2)
        groesse = f.tell()
        f.seek(max(0, groesse - n))
        z = f.read().decode("utf-8", "replace").splitlines()
    return z if groesse <= n else z[1:]


def metrik_codex(pfad, voll=False):
    """Tokens, Kontext, Modell (und mit voll Agentenzeit) einer Codex-Sitzung.
    Ohne voll nur das Dateiende: das letzte token_count genuegt fuer Kontext und Summe."""
    m = {"ctx": 0, "fenster": 0, "modell": "", "tok": None, "arbeit_s": None}
    zeilen = None if voll else _ende_lesen(pfad, 262_144)
    if zeilen is not None and not any('"token_count"' in z for z in zeilen):
        zeilen = None  # nichts im Ende: ganze Datei
    if zeilen is None:
        with open(pfad, encoding="utf-8", errors="replace") as f:
            zeilen = f.read().splitlines()
        voll = True
    start, arbeit = None, 0.0
    for z in zeilen:
        if not any(k in z for k in ('"token_count"', '"turn_context"', '"task_started"',
                                     '"task_complete"', '"turn_aborted"')):
            continue
        try:
            r = json.loads(z)
        except Exception:
            continue
        p = r.get("payload") if isinstance(r, dict) else None
        if not isinstance(p, dict):
            continue
        typ = p.get("type")
        if r.get("type") == "turn_context":
            m["modell"] = _str(p.get("model"))[:60] or m["modell"]
        elif typ == "token_count" and isinstance(p.get("info"), dict):
            info = p["info"]
            ges = info.get("total_token_usage") if isinstance(info.get("total_token_usage"), dict) else {}
            letzt = info.get("last_token_usage") if isinstance(info.get("last_token_usage"), dict) else {}
            # Codex zaehlt den Cache in input_tokens mit
            m["tok"] = {"ein": _int(ges.get("input_tokens")), "cache": _int(ges.get("cached_input_tokens")),
                        "aus": _int(ges.get("output_tokens"))}
            m["ctx"] = _int(letzt.get("total_tokens")) or m["ctx"]
            m["fenster"] = _int(info.get("model_context_window")) or m["fenster"]
        elif typ == "task_started":
            start = zeitstempel(_str(r.get("timestamp")))
        elif typ in ("task_complete", "turn_aborted") and start:
            ende = zeitstempel(_str(r.get("timestamp")))
            if ende and ende >= start:
                arbeit += ende - start
            start = None
    if voll:
        m["arbeit_s"] = int(arbeit)
    return m


def metrik_agy(pfad):
    """Tokens und Kontext einer Agy-Sitzung (Schritte mit input_tokens; Cache getrennt gezaehlt)."""
    m = {"ctx": 0, "fenster": 0, "modell": "", "tok": None, "arbeit_s": None}
    ein = cache = aus = 0
    gefunden = False
    with open(pfad, encoding="utf-8", errors="replace") as f:
        for z in f:
            if '"input_tokens"' not in z:
                continue
            try:
                r = json.loads(z)
            except Exception:
                continue
            if not isinstance(r, dict):
                continue
            i, c = _int(r.get("input_tokens")), _int(r.get("cache_read_tokens"))
            ein, cache, aus = ein + i + c, cache + c, aus + _int(r.get("output_tokens"))
            m["ctx"] = i + c
            gefunden = True
    if gefunden:
        m["tok"] = {"ein": ein, "cache": cache, "aus": aus}
    return m


METRIK_CACHE = os.path.join(os.path.dirname(CACHE), "metrik.json")


def metriken(paare):
    """{Datei: Metrik} fuer die Liste; Cache nach mtime/Groesse (enthaelt nur Zahlen)."""
    try:
        with open(METRIK_CACHE) as f:
            alt = json.load(f)
        alt = alt.get("e", {}) if alt.get("v") == 1 else {}
    except Exception:
        alt = {}
    neu, aus = {}, {}
    for agent, pfad in paare:
        if not pfad:
            continue
        try:
            st = os.stat(pfad)
        except OSError:
            continue
        k = f"{st.st_mtime_ns}:{st.st_size}"
        e = alt.get(pfad)
        if not e or e.get("k") != k:
            try:
                e = dict(metrik_codex(pfad) if agent == "codex" else metrik_agy(pfad), k=k)
            except Exception:
                continue
        neu[pfad] = aus[pfad] = e
    try:
        os.makedirs(os.path.dirname(METRIK_CACHE), mode=0o700, exist_ok=True)
        tmp = METRIK_CACHE + ".tmp"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            json.dump({"v": 1, "e": neu}, f)
        os.replace(tmp, METRIK_CACHE)
    except OSError:
        pass
    return aus


def kzahl(n):
    """Tokenzahl kurz: 850, 182k, 1,2 M."""
    if n < 1000:
        return str(n)
    if n < 1_000_000:
        return f"{round(n / 1000)}k"
    return tr(f"{n / 1e6:.1f} M".replace(".", ","), f"{n / 1e6:.1f}M")


def dauer(s):
    s = int(s)
    if s < 60:
        return tr("< 1 min", "< 1 min")
    if s < 3600:
        return f"{s // 60} min"
    if s < 86400:
        return f"{s // 3600} h {s % 3600 // 60:02d} min"
    return tr(f"{s // 86400} T {s % 86400 // 3600} h", f"{s // 86400} d {s % 86400 // 3600} h")


def vor(ts):
    s = max(0, time.time() - ts)
    if s < 60:
        return tr("gerade eben", "just now")
    return tr(f"vor {dauer(s)}", f"{dauer(s)} ago")


def ordner_zulaessig(cwd):
    """Positivliste: vorhandener Ordner im eigenen Home, ohne '..'."""
    return bool(cwd) and (cwd == HOME or cwd.startswith(HOME + "/")) \
        and ".." not in cwd.split("/") and os.path.isdir(cwd)


def _datensaetze(pfad, teile, filt=None):
    """JSON-Zeilen mit einem der Teile (billiger Vorfilter vor json.loads)."""
    with open(pfad, encoding="utf-8", errors="replace") as f:
        for zeile in f:
            if not any(t in zeile for t in teile) or (filt and not filt(zeile)):
                continue
            try:
                r = json.loads(zeile)
            except Exception:
                continue
            if isinstance(r, dict):
                yield r


def _blocktext(c):
    if isinstance(c, str):
        return c
    if isinstance(c, list):
        # Codex schreibt Eingaben als "text", Antworten als "Text"
        return "\n".join(_str(b.get("text")) for b in c if isinstance(b, dict)
                         and _str(b.get("type")).lower() in ("text", "input_text", "output_text"))
    return ""


def nachrichten_claude(pfad, filt=None):
    for r in _datensaetze(pfad, TEILE_CLAUDE, filt):
        if r.get("type") in ("user", "assistant"):
            yield r["type"], text_aus(r.get("message")), zeitstempel(_str(r.get("timestamp")))


def nachrichten_codex(pfad, filt=None):
    """(rolle, text, zeit) aus einem Codex-Rollout. Neue Rollouts haben
    item_completed (UserMessage/AgentMessage), aeltere nur event_msg.
    Zwischenmeldungen (phase "commentary") zaehlen fuer die Suche, als
    letzte Antwort gilt die Endantwort (Rolle "assistant"), ohne sie die
    letzte Zwischenmeldung (Rolle "zwischen")."""
    aus, neu_texte = [], set()
    for r in _datensaetze(pfad, TEILE_CODEX, filt):
        p = r.get("payload")
        if not isinstance(p, dict):
            continue
        ts = zeitstempel(_str(r.get("timestamp")))
        it = p.get("item")
        if p.get("type") == "item_completed" and isinstance(it, dict):
            rolle = {"UserMessage": "user", "AgentMessage": "assistant"}.get(_str(it.get("type")))
            if rolle == "assistant" and it.get("phase") == "commentary":
                rolle = "zwischen"
            if rolle:
                t = _blocktext(it.get("content")).strip()
                neu_texte.add(t)
                aus.append((rolle, t, ts, True))
        elif r.get("type") == "event_msg" and p.get("type") in ("user_message", "agent_message"):
            rolle = "user" if p["type"] == "user_message" else \
                "zwischen" if p.get("phase") == "commentary" else "assistant"
            aus.append((rolle, _str(p.get("message")).strip(), ts, False))
    # Fortgesetzte alte Sitzungen enthalten beide Formen: alte Datensaetze
    # nur auslassen, wenn dieselbe Nachricht auch in neuer Form vorliegt.
    return [(r, t, z) for r, t, z, neu in aus if t and (neu or t not in neu_texte)
            and not (r == "user" and t.startswith(CODEX_INTERN))]


def nachrichten_agy(pfad, filt=None):
    aus = []
    for r in _datensaetze(pfad, TEILE_AGY, filt):
        ts = zeitstempel(_str(r.get("created_at")))
        if r.get("type") == "USER_INPUT":
            m = AGY_FRAGE.search(_str(r.get("content")))
            if m and m.group(1):
                aus.append(("user", m.group(1), ts))
        elif r.get("type") == "PLANNER_RESPONSE":
            t = _str(r.get("content")).strip()
            if t:
                aus.append(("assistant", t, ts))
    return aus


NACHRICHTEN = {"claude": nachrichten_claude, "codex": nachrichten_codex, "agy": nachrichten_agy}


def zusammenfassen(nachr):
    """Vorschau-Angaben aus (rolle, text, zeit), wie auswerten() fuer Claude."""
    fragen = [t for r, t, _ in nachr if r == "user"]
    antworten = [t for r, t, _ in nachr if r == "assistant"] or [t for r, t, _ in nachr if r == "zwischen"]
    zeiten = [z for _, _, z in nachr if z]
    return {"fragen": len(fragen), "erste": fragen[0][:2000] if fragen else "",
            "letzte": fragen[-1][:2000] if fragen else "", "antwort": antworten[-1][:6000] if antworten else "",
            "beginn": min(zeiten) if zeiten else None, "ende": max(zeiten) if zeiten else None}


def index():
    try:
        with open(CACHE) as f:
            alt = json.load(f)
        alt_e = alt.get("e", {}) if alt.get("v") == VERSION else {}
    except Exception:
        alt_e = {}
    neu = {}
    for pfad in glob.glob(os.path.join(PROJ, "*", "*.jsonl")):
        sid = os.path.basename(pfad)[:-6]
        if not UUID.match(sid):
            continue
        try:
            st = os.stat(pfad)
        except OSError:
            continue
        schluessel = f"{st.st_mtime_ns}:{st.st_size}"
        e = alt_e.get(pfad)
        if not e or e.get("k") != schluessel:
            try:
                e = auswerten(pfad)
            except Exception:
                continue  # eine kaputte Datei soll die Liste nicht leeren
            e["k"] = schluessel
        e["id"] = sid
        e["pfad"] = pfad
        neu[pfad] = e
    try:
        # Nur fuer den Nutzer lesbar: der Index enthaelt Gespraechsauszuege
        # (die Verlaufsdateien selbst sind 0600).
        os.makedirs(os.path.dirname(CACHE), mode=0o700, exist_ok=True)
        tmp = CACHE + ".tmp"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            os.fchmod(f.fileno(), 0o600)
            json.dump({"v": VERSION, "e": neu}, f)
        os.replace(tmp, CACHE)
    except OSError:
        pass
    # Nur Sitzungen mit eigener Eingabe, deren Ordner noch existiert: Andere
    # lassen sich nicht fortsetzen (z. B. Agenten in temporaeren Ordnern).
    return [e for e in neu.values() if e.get("fragen") and e.get("ende") and ordner_zulaessig(e.get("cwd"))]


def offene():
    """Sitzungs-IDs, die gerade in einem laufenden Claude-Prozess offen sind -> PID."""
    return {s: v["pid"] for s, v in laufend().items()}


def laufend():
    """Offene Claude-Sitzungen -> PID, Zustand (busy/idle) und ob Remote Control
    verbunden ist (bridgeSessionId in sessions/<pid>.json; .key-Dateien nie lesen)."""
    r = {}
    for f in glob.glob(os.path.join(REG, "*.json")):
        try:
            with open(f) as h:
                j = json.load(h)
            pid = int(j.get("pid"))
            if j.get("kind") != "interactive" or not UUID.match(j.get("sessionId", "")):
                continue
            os.kill(pid, 0)
            exe = os.readlink(f"/proc/{pid}/exe")
            if "claude" not in exe:
                # npm-Installation: exe ist node, claude steht in der Befehlszeile
                with open(f"/proc/{pid}/cmdline", "rb") as h:
                    if b"claude" not in h.read():
                        continue  # PID wiederverwendet
            r[j["sessionId"]] = {"pid": pid, "status": _str(j.get("status")),
                                 "remote": bool(j.get("bridgeSessionId"))}
        except Exception:
            continue
    return r


def ordner_kurz(cwd):
    if cwd == HOME:
        return "~"
    return "~" + cwd[len(HOME):] if cwd.startswith(HOME + "/") else cwd


def tag(ts):
    dt = datetime.fromtimestamp(ts)
    heute = date.today()
    if dt.date() == heute:
        return tr("Heute     ", "Today      ") + dt.strftime("%H:%M")
    if dt.date() == heute - timedelta(days=1):
        return tr("Gestern   ", "Yesterday  ") + dt.strftime("%H:%M")
    if (heute - dt.date()).days < 7:
        wt = WOCHENTAG[sprache()][dt.weekday()]
        return tr(f"{wt} {dt.strftime('%d.%m.')} ", f"{wt} {dt.strftime('%b %d')} ") + dt.strftime("%H:%M")
    return dt.strftime(tr("%d.%m.%y  %H:%M", "%Y-%m-%d %H:%M"))


def titel(e):
    return sauber(e.get("eigener_titel") or e.get("titel") or e.get("erste") or tr("(ohne Titel)", "(untitled)"))


def andere(agent):
    """Sitzungen eines Agenten ausser Claude (alle, ohne Zeitgrenze): Codex und
    Agy aus agent-launcher-status, die weiteren aus den eigenen Scannern."""
    if agent in WEITERE:
        neueste = {}
        try:
            for i in SCANNER[agent]():
                alt = neueste.get(i["id"])
                if ID_WEITERE.fullmatch(i["id"]) and (alt is None or i["updated"] > alt["updated"]):
                    neueste[i["id"]] = i  # gleiche ID mehrfach: die neueste gilt
        except Exception:
            pass  # Datenbank gesperrt oder kaputt: was bis dahin gelesen ist, bleibt
        return [i for i in neueste.values() if ordner_zulaessig(i["path"])]
    if STATUS is None:
        return []
    try:
        if agent == "codex":
            items = STATUS.codex_sessions(STATUS.window_pids(), 0, limit=None)
        else:
            items = STATUS.agy_sessions(0)
    except Exception:
        return []
    return [i for i in items if isinstance(i, dict) and STATUS.SAFE_ID.fullmatch(str(i.get("id", "")))
            and ordner_zulaessig(str(i.get("path", "")))]


def andere_agenten(agent):
    """Agenten ausser Claude, die fuer die Ansicht gelesen werden."""
    return [a for a in AGENTEN[2:] if agent in ("alle", a)]


def _sek(t):
    """Zeitstempel in Sekunden (Millisekunden, Sekunden oder ISO-Text)."""
    if isinstance(t, str):
        return zeitstempel(t) or 0.0
    try:
        v = float(t or 0)
    except (TypeError, ValueError, OverflowError):
        return 0.0
    return v / 1000 if v > 1e12 else v


def _mtime(pfad):
    try:
        return os.stat(pfad).st_mtime
    except OSError:
        return 0.0


def _unteragent(d):
    """Ausdrueckliche Kennzeichen von Unteragenten (keine Raterei an IDs)."""
    if not isinstance(d, dict):
        return False
    art = _str(d.get("kind") or d.get("session_kind") or d.get("thread_source")).lower()
    return d.get("isSubagent") is True or d.get("is_subagent") is True or art.startswith(("subagent", "sub-agent"))


def _kopf(pfad, n):
    """Die ersten n JSON-Objekte einer JSONL-Datei."""
    aus = []
    with open(pfad, encoding="utf-8", errors="replace") as f:
        for _ in range(n):
            zeile = f.readline(262144)
            if not zeile:
                break
            try:
                r = json.loads(zeile)
            except Exception:
                continue
            if isinstance(r, dict):
                aus.append(r)
    return aus


def _json(pfad, max_bytes=2_000_000):
    if os.path.getsize(pfad) > max_bytes:
        return None
    with open(pfad, encoding="utf-8", errors="replace") as f:
        d = json.load(f)
    return d if isinstance(d, dict) else None


def _text(c):
    """Lesbarer Text aus den gaengigen Formen (Text, Liste von Teilen mit
    "text", auch ohne "type"); eingeschobene Bloecke wie <context> nicht."""
    if isinstance(c, list):
        c = "".join(x if isinstance(x, str) else _str(x.get("text")) if isinstance(x, dict) else "" for x in c)
    t = _str(c).strip()
    return "" if t.startswith("<") else t


def _je_datei(muster, lesen, rekursiv=False):
    """lesen(pfad) fuer jede Datei; eine kaputte, halb geschriebene oder
    unlesbare Datei faellt allein weg, nicht die ganze Liste."""
    for f in glob.glob(muster, recursive=rekursiv):
        try:
            e = lesen(f)
        except (OSError, ValueError, TypeError, AttributeError, RecursionError):
            continue
        if e:
            yield e


def _sqlite(pfad):
    # mode=ro aendert den Inhalt nie; im WAL-Modus kann SQLite aber die
    # Hilfsdateien -shm/-wal anlegen bzw. auffrischen (wie jeder Leser).
    con = sqlite3.connect("file:" + urllib.parse.quote(pfad) + "?mode=ro", uri=True, timeout=0.5)
    con.execute("pragma query_only = on")
    return con


def _eintrag(agent, sid, titel_, cwd, zeit):
    return {"agent": agent, "id": _str(sid), "title": _str(titel_), "path": _str(cwd),
            "updated": zeit, "active": False}


def _scan_opencode():
    con = _sqlite(OPENCODE_DB)
    try:
        sql = "select id, title, directory, time_updated from session where parent_id is null"
        try:  # archivierte Sitzungen blendet opencode selbst aus
            rows = con.execute(sql + " and time_archived is null").fetchall()
        except sqlite3.OperationalError:  # aeltere Datenbank ohne die Spalte
            rows = con.execute(sql).fetchall()
    finally:
        con.close()
    for sid, t, d, zeit in rows:
        yield _eintrag("opencode", sid, t, d, _sek(zeit))


def _copilot_neu(f):
    sid, titel_, cwd, start, kind = os.path.basename(os.path.dirname(f)), "", "", False, False
    for r in _kopf(f, 200):
        d = r.get("data") if isinstance(r.get("data"), dict) else {}
        ctx = d.get("context") if isinstance(d.get("context"), dict) else {}
        if r.get("type") == "session.start":
            start = True
            sid = d.get("sessionId") or sid
            cwd = ctx.get("cwd") or d.get("cwd") or cwd
            titel_ = _str(d.get("name")) or titel_
            kind = _unteragent(d) or _unteragent(ctx) or bool(d.get("parentSessionId") or ctx.get("parentSessionId"))
        elif r.get("type") == "user.message" and not titel_:
            titel_ = _text(d.get("content"))
        elif r.get("type") == "session.task_complete" and not titel_:
            titel_ = _str(d.get("summary"))
        if kind or (start and titel_):
            break
    return _eintrag("copilot", sid, titel_, cwd, _mtime(f)) if start and not kind else None


def _copilot_alt(f):  # Ablage vor Copilot CLI 0.0.342
    d = _json(f)
    if not d or _unteragent(d) or d.get("parentSessionId"):
        return None
    ctx = d.get("context") if isinstance(d.get("context"), dict) else {}
    return _eintrag("copilot", os.path.basename(f)[:-5], d.get("summary") or d.get("title"),
                    d.get("cwd") or ctx.get("cwd"), _mtime(f))


def _scan_copilot():
    yield from _je_datei(os.path.join(COPILOT, "session-state", "*", "events.jsonl"), _copilot_neu)
    yield from _je_datei(os.path.join(COPILOT, "history-session-state", "*.json"), _copilot_alt)


def _pi(f):
    kopf, titel_ = None, ""
    for r in _kopf(f, 30):
        if r.get("type") == "session" and kopf is None:
            kopf = r
        m = r.get("message") if isinstance(r.get("message"), dict) else {}
        if m.get("role") == "user" and not titel_:
            titel_ = _text(m.get("content"))
        if kopf is not None and titel_:
            break
    return _eintrag("pi", kopf.get("id"), titel_, kopf.get("cwd"), _mtime(f)) \
        if kopf and not _unteragent(kopf) else None


def _scan_pi():
    yield from _je_datei(os.path.join(PI, "**", "*.jsonl"), _pi, rekursiv=True)


def _gemini(f):
    meta, nachr = {}, []
    if f.endswith(".jsonl"):
        for r in _kopf(f, 200):
            if isinstance(r.get("$set"), dict):
                meta.update(r["$set"])
            elif r.get("sessionId") and r.get("projectHash"):
                meta.update(r)
                nachr += r.get("messages") if isinstance(r.get("messages"), list) else []
            elif r.get("type"):
                nachr.append(r)
    else:
        meta = _json(f, 20_000_000) or {}  # alte Form: ganze Sitzung in einer Datei
        nachr = meta.get("messages") or meta.get("history") or []
    if not meta.get("sessionId") or _unteragent(meta) or meta.get("parentSessionId"):
        return None
    titel_ = _str(meta.get("summary"))
    for m in nachr if isinstance(nachr, list) else []:
        if not titel_ and isinstance(m, dict) and (m.get("type") or m.get("role")) == "user":
            titel_ = _text(m.get("content"))
    try:
        with open(os.path.join(os.path.dirname(os.path.dirname(f)), ".project_root"),
                  encoding="utf-8", errors="replace") as h:
            cwd = h.read(4096).strip()
    except OSError:
        cwd = ""
    ordner = meta.get("directories")
    if not cwd and isinstance(ordner, list) and ordner:
        cwd = _str(ordner[0])
    return _eintrag("gemini", meta["sessionId"], titel_, cwd or HOME, _mtime(f))


def _scan_gemini():
    yield from _je_datei(os.path.join(GEMINI_TMP, "*", "chats", "session-*.json*"), _gemini)


def _scan_grok():
    kinder = set()

    def kind(f):
        d = _json(f) or {}
        return [os.path.basename(os.path.dirname(f))] + \
            [d.get(k) for k in ("child_session_id", "session_id", "subagent_id", "id") if isinstance(d.get(k), str)]
    for ids in _je_datei(os.path.join(GROK, "sessions", "*", "*", "subagents", "*", "meta.json"), kind):
        kinder.update(ids)

    def sitzung(f):
        d = _json(f)
        info = d.get("info") if d and isinstance(d.get("info"), dict) else {}
        sid = _str(info.get("id")) or os.path.basename(os.path.dirname(f))
        # parent_session_id ist kein Kennzeichen: Grok setzt es auch bei Abzweigen des Nutzers.
        if not d or sid in kinder or _unteragent(d) or d.get("hidden") is True:
            return None
        titel_ = d.get("generated_title") or d.get("session_summary") or d.get("last_turn_summary")
        return _eintrag("grok", sid, titel_, info.get("cwd"), _sek(d.get("updated_at")) or _mtime(f))
    yield from _je_datei(os.path.join(GROK, "sessions", "*", "*", "summary.json"), sitzung)


SCANNER = {"opencode": _scan_opencode, "copilot": _scan_copilot, "pi": _scan_pi,
           "gemini": _scan_gemini, "grok": _scan_grok}


def opencode_texte(sids, filt=None):
    """{Sitzung: [(rolle, text, zeit)]} aus der opencode-Datenbank, eine
    Verbindung fuer alle Sitzungen. Nur Textteile (keine Werkzeuge, keine
    eingefuegten Dateien); Teile derselben Nachricht werden eine Nachricht."""
    sids = list(sids)
    aus = {s: [] for s in sids}
    if not sids:
        return aus
    con = _sqlite(OPENCODE_DB)
    try:
        rows = con.execute(
            "select p.session_id, p.message_id, m.data, p.data, p.time_created from part p"
            " join message m on m.id = p.message_id where p.session_id in (%s)"
            " and p.data like '%%\"text\"%%' order by p.session_id, p.time_created, p.id"
            % ",".join("?" * len(sids)), sids).fetchall()
    finally:
        con.close()
    letzte = {}
    for sid, mid, md, pd, zeit in rows:
        if not isinstance(pd, str) or (filt and not filt(pd)):
            continue
        try:
            m, p = json.loads(md), json.loads(pd)
        except Exception:
            continue
        if not isinstance(m, dict) or not isinstance(p, dict) or p.get("type") != "text" \
                or p.get("synthetic") or p.get("ignored"):
            continue
        rolle, t = m.get("role"), _str(p.get("text")).strip()
        if rolle not in ("user", "assistant") or not t:
            continue
        if letzte.get(sid) == mid:  # weiterer Textteil derselben Nachricht
            r, alt, z = aus[sid][-1]
            aus[sid][-1] = (r, alt + "\n" + t, z)
        else:
            aus[sid].append((rolle, t, _sek(zeit) or None))
            letzte[sid] = mid
    return aus


def _claude_zeile(e, auf, fern=()):
    return {"key": e["id"], "agent": "claude", "ende": e["ende"], "titel": titel(e),
            "cwd": e["cwd"], "aktiv": e["id"] in auf, "remote": e["id"] in fern, "ctx": e.get("ctx")}


def _andere_zeile(i):
    return {"key": f"{i['agent']}:{i['id']}", "agent": i["agent"], "ende": float(i.get("updated") or 0),
            "titel": sauber(str(i.get("title") or "")) or tr("(ohne Titel)", "(untitled)"), "cwd": str(i["path"]),
            "aktiv": bool(i.get("active"))}


def _formatieren(zeilen_, treffer=None, mit_agent=False):
    """Haupt-Ordner (haeufigster) wird nicht angezeigt, andere grau dahinter."""
    zeilen_.sort(key=lambda r: r["ende"], reverse=True)
    haupt = None
    if zeilen_:
        zaehler = {}
        for r in zeilen_:
            zaehler[r["cwd"]] = zaehler.get(r["cwd"], 0) + 1
        haupt = max(zaehler, key=zaehler.get)
    aus = []
    for r in zeilen_:
        mark = FERN if r.get("remote") else "●" if r["aktiv"] else " "
        wer = f"\x1b[2m{name(r['agent']):<8}\x1b[0m " if mit_agent else ""
        extra = f"  [{treffer[r['key']]}×]" if treffer else ""
        if r.get("ctx"):
            extra = f"  \x1b[2m{kzahl(r['ctx'])}\x1b[0m" + extra
        ordner = "" if r["cwd"] == haupt else f"  \x1b[2m{kurz(sauber(ordner_kurz(r['cwd'])), 30)}\x1b[0m"
        aus.append(f"{r['key']}\t{tag(r['ende'])} {mark} {wer}{kurz(sauber(r['titel']), 60)}{extra}{ordner}")
    return aus


def liste(agent="alle"):
    """Zeilen fuer die gewaehlte Agenten-Ansicht, neueste oben."""
    r = []
    if agent in ("alle", "claude"):
        lauf = laufend()
        auf, fern = set(lauf), {s for s, v in lauf.items() if v["remote"]}
        r += [_claude_zeile(e, auf, fern) for e in index()]
    for a in andere_agenten(agent):
        items = andere(a)
        m = metriken([(a, datei_andere(i)) for i in items]) if a in ("codex", "agy") else {}
        for i in items:
            z = _andere_zeile(i)
            z["ctx"] = (m.get(datei_andere(i)) or {}).get("ctx") if m else None
            r.append(z)
    return _formatieren(r, mit_agent=(agent == "alle"))


def rahmen(agent):
    """Agentenwahl oben im Fensterrahmen; die gewaehlte ist invertiert."""
    return " " + " ".join(f"\x1b[7m {name(a)} \x1b[0m" if a == agent else f" {name(a)} "
                          for a in AGENTEN) + " "


def aktueller_agent():
    m = re.search(r"\x1b\[7m (\w+) ", os.environ.get("FZF_BORDER_LABEL", ""))
    return next((a for a in AGENTEN if m and name(a) == m.group(1)), "alle")


def wechsel(schritt):
    """fzf-transform: naechste/vorige Agenten-Ansicht (Tab/Shift+Tab, 0 = neu laden)."""
    a = AGENTEN[(AGENTEN.index(aktueller_agent()) + schritt) % len(AGENTEN)]
    print(f"reload('{SELF}' --liste --agent {a})+change-prompt({tr('Suche', 'Search')} › )+clear-query"
          f"+change-border-label:{rahmen(a)}")


def datei_andere(i):
    """Verlaufsdatei einer Codex-/Agy-Sitzung oder None (Agy: nicht jede hat eine)."""
    if i.get("agent") == "codex":
        f = str(i.get("file") or "")
        return f if f.startswith(CODEX + "/") and f.endswith(".jsonl") and os.path.isfile(f) else None
    d = os.path.join(AGY_BRAIN, i["id"], ".system_generated", "logs")  # id ist per SAFE_ID geprueft
    for n in ("transcript_full.jsonl", "transcript.jsonl"):  # _full ist nicht gekuerzt
        if os.path.isfile(os.path.join(d, n)):
            return os.path.join(d, n)
    return None


def verlauf(i, filt=None):
    """(rolle, text, zeit) einer Sitzung ausser Claude; None ohne lesbaren Verlauf."""
    if i["agent"] == "opencode":
        return opencode_texte([i["id"]], filt)[i["id"]]
    if i["agent"] in ("codex", "agy"):
        d = datei_andere(i)
        return NACHRICHTEN[i["agent"]](d, filt) if d else None
    return None  # experimentelle Agenten: nur Liste und Fortsetzen


def _kandidaten(muster, dateien):
    """Dateien, die eines der Muster enthalten (rg); ohne rg alle."""
    if shutil.which("rg") and dateien:
        befehl = ["rg", "-l", "-i", "-F", "--no-ignore", "--hidden", "--no-messages"]
        for m in muster:
            befehl += ["-e", m]
        try:
            r = subprocess.run(befehl + ["--"] + dateien, capture_output=True, text=True, timeout=60)
            if r.returncode in (0, 1):
                return set(r.stdout.splitlines())
        except (OSError, ValueError, subprocess.SubprocessError):
            pass
    return set(dateien)


def inhaltssuche(q, agent="alle"):
    """Sucht im eigentlichen Gespraechstext (Eingaben und Antworten, ohne
    system-reminder bzw. Agy-Metadaten), nicht im Rohformat."""
    q = sauber(q)
    if not q:
        return [], {}
    quellen = []  # (Zeile, Agent, Datei)
    if agent in ("alle", "claude"):
        auf = offene()
        quellen += [(_claude_zeile(e, auf), "claude", e["pfad"]) for e in index() if e.get("pfad")]
    direkt = []  # ohne Datei-Vorfilter (Datenbank)
    for a in andere_agenten(agent):
        if a == "opencode":
            direkt = andere(a)
        elif a in ("codex", "agy"):
            for i in andere(a):
                d = datei_andere(i)
                if d:
                    quellen.append((_andere_zeile(i), a, d))
    # Die Verlaufsdateien sind JSON: " und \ stehen dort maskiert, Umlaute
    # mal im Klartext, mal als \uXXXX. Vorfilter daher mit beiden maskierten
    # Formen, gezaehlt wird im entpackten Text.
    # rg -i und lower() greifen nicht in \uXXXX: Ü steht dort als \u00dc,
    # ü als \u00fc. Daher auch die maskierten Formen in Klein- und Grossschrift.
    muster = {json.dumps(q, ensure_ascii=False)[1:-1]} | {json.dumps(v)[1:-1] for v in (q, q.lower(), q.upper())}
    ml, ql = [m.lower() for m in muster], q.lower()

    def filt(zeile):
        z = zeile.lower()
        return any(m in z for m in ml)

    kandidaten = _kandidaten(sorted(muster), [d for _, _, d in quellen])
    treffer, gefunden = {}, []
    for z, a, d in quellen:
        if d not in kandidaten:
            continue
        try:
            n = sum(t.lower().count(ql) for _, t, _ in NACHRICHTEN[a](d, filt))
        except Exception:  # eine kaputte Datei soll die Trefferliste nicht leeren
            continue
        if n:
            treffer[z["key"]] = n
            gefunden.append(z)
    try:
        texte = opencode_texte([i["id"] for i in direkt], filt)
    except Exception:  # Datenbank gesperrt oder kaputt
        texte = {}
    for i in direkt:
        n = sum(t.lower().count(ql) for _, t, _ in texte.get(i["id"], []))
        if n:
            z = _andere_zeile(i)
            treffer[z["key"]] = n
            gefunden.append(z)
    return gefunden, treffer


def finde(sid):
    if not UUID.match(sid or ""):
        return None
    for pfad in glob.glob(os.path.join(PROJ, "*", sid + ".jsonl")):
        return pfad
    return None


def letzte_antwort(pfad):
    """Letzte Textantwort von Claude; liest nur das Dateiende."""
    with open(pfad, "rb") as f:
        f.seek(0, 2)
        f.seek(max(0, f.tell() - 3_000_000))
        rest = f.read().decode("utf-8", "replace").splitlines()
    for zeile in reversed(rest):
        if '"type":"assistant"' not in zeile:
            continue
        try:
            r = json.loads(zeile)
        except Exception:
            continue
        if isinstance(r, dict) and not r.get("isSidechain"):
            t = text_aus(r.get("message"))
            if t:
                return t[:6000]
    return ""


def _andere_finden(schluessel):
    agent, _, sid = (schluessel or "").partition(":")
    if agent not in AGENTEN[2:]:
        return None
    return next((i for i in andere(agent) if i["id"] == sid), None)


def ZEITFORMAT():
    return tr("%d.%m.%Y %H:%M", "%Y-%m-%d %H:%M")


def _vorschau_drucken(titel_, agent, cwd, e, offen, info=None):
    B, D, N = "\x1b[1m", "\x1b[2m", "\x1b[0m"

    def absatz(s, n):
        z = [x[:2000] for x in sauber(s, einzeilig=False).splitlines()]  # Umbruch macht fzf (wrap-word)
        return "\n".join(z[:n] + ([D + "…" + N] if len(z) > n else []))

    print(B + sauber(titel_) + N)
    wer = "" if agent == "claude" else f"{D}Agent:{N} {name(agent)}   "
    zahl = "" if e["fragen"] is None else f"   {D}{tr('Eingaben', 'Prompts')}:{N} {e['fragen']}"
    print(f"{wer}{D}{tr('Ordner', 'Folder')}:{N} {sauber(ordner_kurz(cwd))}{zahl}")
    von = datetime.fromtimestamp(e["beginn"]).strftime(ZEITFORMAT()) if e["beginn"] else "?"
    bis = datetime.fromtimestamp(e["ende"]).strftime(ZEITFORMAT()) if e["ende"] else "?"
    rel = f"  {D}({vor(e['ende'])}){N}" if e["ende"] else ""
    print(f"{D}{tr('Zeitraum', 'Period')}:{N} {von} - {bis}{rel}")
    info = info or {}
    teile = []
    if e["beginn"] and e["ende"] and e["ende"] >= e["beginn"]:
        teile.append(f"{D}{tr('Dauer', 'Duration')}:{N} {dauer(e['ende'] - e['beginn'])}")
    if info.get("arbeit_s"):
        teile.append(f"{D}{tr('Agent arbeitete', 'Agent worked')}:{N} {dauer(info['arbeit_s'])}")
    if teile:
        print("   ".join(teile))
    if info.get("ctx"):
        k = kzahl(info["ctx"])
        if info.get("fenster"):
            k += tr(f" von {kzahl(info['fenster'])} ({round(100 * info['ctx'] / info['fenster'])} %)",
                    f" of {kzahl(info['fenster'])} ({round(100 * info['ctx'] / info['fenster'])} %)")
        mod = f"   {D}{tr('Modell', 'Model')}:{N} {sauber(info['modell'])}" if info.get("modell") else ""
        print(f"{D}{tr('Kontext', 'Context')}:{N} {k}{mod}")
    tok = info.get("tok")
    if tok and (tok["ein"] or tok["aus"]):
        cache = tr(f" (davon {kzahl(tok['cache'])} aus dem Cache)", f" ({kzahl(tok['cache'])} from cache)") \
            if tok["cache"] else ""
        print(f"{D}Tokens:{N} {tr('Eingabe', 'input')} {kzahl(tok['ein'])}{cache} · "
              f"{tr('Ausgabe', 'output')} {kzahl(tok['aus'])}")
    if offen:
        zustand = {"busy": tr("arbeitet", "working"), "idle": tr("wartet auf Eingabe", "waiting for input")}
        z = zustand.get(info.get("status"), "")
        if info.get("remote"):
            text = FERN + " " + tr("gerade offen, per Remote Control erreichbar", "open now, reachable via Remote Control")
        else:
            text = "● " + tr("gerade in einem Fenster offen", "open in a window right now")
        print("\x1b[33m" + text + (f" · {z}" if z else "") + "\x1b[0m")
    if e["erste"]:
        print()
        print(B + tr("Erste Eingabe", "First prompt") + N)
        print(absatz(e["erste"], 8))
    if e["letzte"] and e["letzte"] != e["erste"]:
        print()
        print(B + tr("Letzte Eingabe", "Last prompt") + N)
        print(absatz(e["letzte"], 6))
    if e.get("antwort"):
        print()
        print(B + tr("Letzte Antwort", "Last answer") + N)
        print(absatz(e["antwort"], 14))


def vorschau_andere(schluessel):
    i = _andere_finden(schluessel)
    if not i:
        print(tr("Sitzung nicht gefunden.", "Session not found."))
        return
    e = {"fragen": 0, "erste": "", "letzte": "", "antwort": "", "beginn": None, "ende": None}
    try:
        v = verlauf(i)
    except Exception:
        v = None
    if v:
        e = zusammenfassen(v)
    else:
        e["fragen"] = None  # ohne Verlauf keine Zahl anzeigen
    if not e["ende"]:
        e["ende"] = float(i.get("updated") or 0) or None
    info = None
    d = datei_andere(i) if i["agent"] in ("codex", "agy") else None
    if d:
        try:
            info = metrik_codex(d, voll=True) if i["agent"] == "codex" else metrik_agy(d)
        except Exception:
            info = None
    _vorschau_drucken(str(i.get("title") or tr("(ohne Titel)", "(untitled)")), i["agent"],
                      str(i["path"]), e, bool(i.get("active")), info)
    if i["agent"] in WEITERE and not WEITERE[i["agent"]][2]:
        print()
        print("\x1b[2m" + tr(f"{name(i['agent'])} ist experimentell: Liste und Fortsetzen, "
                              "noch ohne Verlauf in der Vorschau und ohne Inhaltssuche.",
                              f"{name(i['agent'])} is experimental: list and resume, "
                              "no transcript preview or content search yet.") + "\x1b[0m")
    elif not v or not e["fragen"]:
        print()
        print("\x1b[2m" + tr("Kein lesbarer Verlauf gefunden.", "No readable transcript found.") + "\x1b[0m")


def vorschau(sid):
    if ":" in (sid or ""):
        return vorschau_andere(sid)
    pfad = finde(sid)
    if not pfad:
        print(tr("Sitzung nicht gefunden.", "Session not found."))
        return
    e = auswerten(pfad)
    e["antwort"] = letzte_antwort(pfad)
    lauf = laufend().get(sid)
    info = {"ctx": e["ctx"], "modell": e["modell"], "tok": e["tok"], "arbeit_s": e["arbeit_s"],
            "status": (lauf or {}).get("status"), "remote": bool(lauf and lauf["remote"])}
    _vorschau_drucken(titel(e), "claude", e["cwd"], e, lauf is not None, info)


def melden(text, kritisch=False):
    if shutil.which("notify-send"):
        subprocess.run(["notify-send", "-u", "critical" if kritisch else "normal",
                        tr("Agenten-Sitzungen", "Agent sessions"), text], timeout=5, check=False)
    else:
        print(text, file=sys.stderr)


def fenster_zu_pid(pid):
    """Hyprland-Fenster, in dem der Claude-Prozess laeuft (Elternkette hoch)."""
    if not shutil.which("hyprctl"):
        return None
    try:
        clients = json.loads(subprocess.run(["hyprctl", "clients", "-j"], capture_output=True,
                                            text=True, timeout=5).stdout)
    except Exception:
        return None
    nach_pid = {c.get("pid"): c.get("address") for c in clients}
    p = pid
    for _ in range(30):
        if p in nach_pid:
            return nach_pid[p]
        try:
            with open(f"/proc/{p}/stat") as f:
                p = int(f.read().rsplit(")", 1)[1].split()[1])
        except Exception:
            return None
        if p <= 1:
            return None
    return None


def starten(befehl, cwd):
    fehlt = [p for p in (befehl[0], "setsid", "xdg-terminal-exec") if not shutil.which(p)]
    if fehlt:
        melden(tr("Nicht gefunden: ", "Not found: ") + ", ".join(fehlt), True)
        return
    # Aus einer Claude-Sitzung heraus gestartet, erbt der neue Prozess sonst
    # CLAUDE_CODE_CHILD_SESSION u. Ae. und speichert seinen Verlauf nicht.
    umg = {k: v for k, v in os.environ.items() if k not in LAUFZEIT_VARS}
    terminal = ["xdg-terminal-exec", "--app-id=org.omarchy.agent", "-e"]
    if shutil.which("uwsm-app"):
        terminal = ["uwsm-app", "--"] + terminal
    subprocess.Popen(["setsid", "-f"] + terminal + befehl, cwd=cwd, env=umg,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def oeffnen_andere(schluessel, abzweig=False):
    i = _andere_finden(schluessel)
    if not i:
        melden(tr("Sitzung nicht gefunden.", "Session not found."), True)
        return
    if abzweig:
        melden(tr("Abzweig gibt es bisher nur für Claude.", "Fork is Claude-only so far."), True)
        return
    pid = int(i.get("focusPid") or 0)
    if i.get("active"):
        # Dieselbe Sitzung nicht zweimal fortsetzen.
        if pid > 0 and shutil.which("hyprctl"):
            subprocess.run(["hyprctl", "dispatch", f'hl.dsp.focus({{ window = "pid:{pid}" }})'],
                           capture_output=True, timeout=5)
        else:
            melden(tr("Diese Sitzung ist schon offen, ihr Fenster wurde nicht gefunden.",
                      "This session is already open, but its window was not found."), True)
        return
    if i["agent"] in WEITERE:
        befehl = WEITERE[i["agent"]][1] + [i["id"]]
    else:
        befehl = ["codex", "resume", i["id"]] if i["agent"] == "codex" else ["agy", "--conversation", i["id"]]
    starten(befehl, i["path"])


def oeffnen(sid, abzweig=False):
    if not sid:
        return  # Enter auf leerer Liste
    if ":" in sid:
        return oeffnen_andere(sid, abzweig)
    pfad = finde(sid)
    if not pfad:
        melden(tr("Sitzung nicht gefunden.", "Session not found."), True)
        return
    auf = offene()
    if not abzweig and sid in auf:
        # Dieselbe Sitzung nicht zweimal fortsetzen: Fenster nach vorn holen.
        adr = fenster_zu_pid(auf[sid])
        if adr and re.match(r"^0x[0-9a-f]+$", adr):
            subprocess.run(["hyprctl", "dispatch", f'hl.dsp.focus({{ window = "address:{adr}" }})'],
                           capture_output=True)
            return
        melden(tr("Diese Sitzung ist schon offen, ihr Fenster wurde nicht gefunden. "
                  "Mit Strg+F als Abzweig öffnen.",
                  "This session is already open, but its window was not found. "
                  "Use Ctrl+F to open a fork."), True)
        return
    cwd = auswerten(pfad)["cwd"]
    if not ordner_zulaessig(cwd):
        melden(tr("Ordner der Sitzung fehlt oder ist unzulässig: ",
                  "Session folder is missing or not allowed: ") + sauber(cwd), True)
        return
    starten(["claude", "--resume", sid] + (["--fork-session"] if abzweig else []), cwd)


def oberflaeche():
    if not shutil.which("fzf"):
        print(tr("fzf fehlt: bitte das Paket fzf installieren.", "fzf is missing: please install the fzf package."))
        time.sleep(3)
        return
    try:  # transform, Labels und wrap-word brauchen ein aktuelles fzf
        v = subprocess.run(["fzf", "--version"], capture_output=True, text=True, timeout=5).stdout
        if tuple(int(x) for x in re.findall(r"\d+", v)[:2]) < (0, 74):
            print(tr(f"fzf {v.split()[0]} ist zu alt, nötig ist 0.74 oder neuer.",
                     f"fzf {v.split()[0]} is too old, 0.74 or newer is needed."))
            time.sleep(4)
            return
    except (OSError, ValueError, IndexError, subprocess.SubprocessError):
        pass
    me = SELF
    kopf = tr("Tab/Shift+Tab Agent · Enter fortsetzen · Strg+F Abzweig (Claude) · Esc schließen\n"
              f"Strg+S im Gesprächsinhalt suchen · Strg+R neu laden · ● offen · {FERN} Remote · 182k = Kontext",
              "Tab/Shift+Tab agent · Enter resume · Ctrl+F fork (Claude) · Esc close\n"
              f"Ctrl+S search content · Ctrl+R reload · ● open · {FERN} remote · 182k = context")
    args = [
        "fzf", "--ansi", "--delimiter=\t", "--with-nth=2..", "--no-sort", "--tiebreak=index",
        "--layout=reverse", "--info=inline-right", "--header", kopf, "--header-first",
        "--prompt", tr("Suche", "Search") + " › ", "--border=rounded", "--border-label", rahmen("alle"),
        "--preview", f"'{me}' --vorschau {{1}}", "--preview-window=down,50%,wrap-word,border-top",
        "--bind", f"enter:execute-silent('{me}' --oeffnen {{1}})+abort",
        "--bind", f"ctrl-f:execute-silent('{me}' --oeffnen {{1}} --abzweig)+abort",
        "--bind", f"ctrl-s:reload('{me}' --liste --inhalt {{q}})"
                  f"+transform-prompt(printf '{tr('Im Inhalt', 'In content')}: %s › ' {{q}})+clear-query",
        "--bind", f"tab:transform('{me}' --wechsel 1)",
        "--bind", f"shift-tab:transform('{me}' --wechsel -1)",
        "--bind", f"ctrl-r:transform('{me}' --wechsel 0)",
    ]
    subprocess.run(args, input="\n".join(liste("alle")) + "\n", text=True)


def main(a):
    if len(a) >= 2 and a[0] == "--lang":  # vom Widget: Einstellung language
        if a[1] in ("de", "en"):
            os.environ["AGENT_LAUNCHERS_LANG"] = a[1]  # erben auch die fzf-Aufrufe
        a = a[2:]
    if not a:
        oberflaeche()
    elif a[0] == "--liste":
        if len(a) >= 3 and a[1] == "--inhalt":
            agent = aktueller_agent()  # fzf gibt FZF_BORDER_LABEL an reload weiter
            e, t = inhaltssuche(" ".join(a[2:]), agent)
            z = _formatieren(e, t, mit_agent=(agent == "alle"))
        elif len(a) == 3 and a[1] == "--agent" and a[2] in AGENTEN:
            z = liste(a[2])
        else:
            z = liste("alle")
        if z:  # leere Ansicht: keine Leerzeile, sonst zeigt fzf "1/1"
            print("\n".join(z))
    elif a[0] == "--wechsel" and len(a) == 2 and a[1] in ("1", "-1", "0"):
        wechsel(int(a[1]))
    elif a[0] == "--vorschau" and len(a) == 2:
        vorschau(a[1])
    elif a[0] == "--oeffnen" and len(a) in (2, 3):
        oeffnen(a[1], abzweig=(len(a) == 3 and a[2] == "--abzweig"))
    else:
        print(__doc__)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
